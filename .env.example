# Copy this file to .env for local testing (never commit the real .env).
# In production these are set as GitHub Actions repo secrets instead.

# Free API key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# The Gmail address the email will be sent FROM (and by default, sent TO)
GMAIL_ADDRESS=

# A Gmail "app password" (NOT your normal password) - see README for how to create one
GMAIL_APP_PASSWORD=

# Optional: where the recommendation email should be sent. Defaults to GMAIL_ADDRESS if unset.
EMAIL_TO=

# Optional: how many days ahead to look for games. Defaults to 7.
LOOKAHEAD_DAYS=7

# Optional: how many days back to look for last week's "replay" pick. Defaults to 7.
LOOKBACK_DAYS=7

# Optional but recommended: API key from https://console.anthropic.com
# Used to pick the best "replay" game from last week using real match
# drama (comebacks, upsets) rather than just a fixed formula. Without
# this, replay picks fall back to a simple stats-only heuristic.
ANTHROPIC_API_KEY=

# Optional: override which Claude model does the replay picking.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
