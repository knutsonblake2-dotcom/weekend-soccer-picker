# Copy this file to .env for local testing (never commit the real .env).
# In production these are set as GitHub Actions repo secrets instead.

# Free API key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# The Gmail address the email will be sent FROM (and by default, sent TO)
GMAIL_ADDRESS=

# A Gmail "app password" (NOT your normal password) - see README for how to create one
GMAIL_APP_PASSWORD=

# Optional: where the recommendation email should be sent. Defaults to GMAIL_ADDRESS if unset.
EMAIL_TO=

# Optional: how many days ahead to look for games. Defaults to 7.
LOOKAHEAD_DAYS=7
